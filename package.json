{
  "name": "intern",
  "version": "1.0.0",
  "description": "Сектор 503 — антивирусный ретро-шутер в корпусе портативной консоли",
  "main": "dist/index.js",
  "scripts": {
    "dev": "webpack serve",
    "build": "webpack --mode production --devtool source-map --output-clean && node scripts/copy-assets.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "test": "vitest run",
    "preview": "node scripts/preview.cjs"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.13",
    "@babel/eslint-plugin": "^7.29.7",
    "@types/classnames": "^2.3.0",
    "@types/react": "17.0.2",
    "@types/react-dom": "17.0.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "css-loader": "^6.5.1",
    "eslint": "8.38.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^2.0.0",
    "eslint-import-resolver-webpack": "^0.12.2",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-json": "^3.0.5",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-sort-class-members": "^1.7.0",
    "html-webpack-plugin": "^5.6.8",
    "less": "4.2.0",
    "less-loader": "^11.1.4",
    "prettier": "2.8.8",
    "react": "17.0.2",
    "react-dom": "^17.0.2",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.3",
    "url-loader": "^4.1.1",
    "vitest": "^2.1.9",
    "webpack": "^5.92.1",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.11.1"
  },
  "private": true,
  "dependencies": {
    "classnames": "^2.3.2"
  }
}
